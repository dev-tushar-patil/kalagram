# Copy to .env (git-ignored) and fill in. Spring Boot loads it automatically on startup.
# Values are read as Java properties: do not wrap them in quotes.

# --- Required -------------------------------------------------------------
DB_PASSWORD=
# At least 32 characters. Generate one, e.g.  openssl rand -base64 48
JWT_SECRET=
# First admin account, created on startup when no admin exists yet.
ADMIN_EMAIL=admin@kalagram.org
ADMIN_PASSWORD=

# --- Database (defaults shown) --------------------------------------------
#DB_URL=jdbc:mysql://localhost:3306/kalagram?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
#DB_USERNAME=root

# --- Server ---------------------------------------------------------------
#SERVER_PORT=8080
#CORS_ALLOWED_ORIGINS=http://localhost:5180
#UPLOAD_DIR=uploads
#UPLOAD_MAX_SIZE=20MB
#JWT_EXPIRY_HOURS=8
# Requests per minute, per IP, for login / registration / enquiry submission.
#RATE_LIMIT_PER_MINUTE=20
# Sample workshops, batches, gallery and resources, inserted only into empty tables.
# Set to false before going live with real content.
#SEED_SAMPLE_DATA=true
# Set to "framework" only behind a trusted reverse proxy.
#FORWARD_HEADERS=none

# --- Optional: automatic WhatsApp notifications (Cloud API) ---------------
#WHATSAPP_ENABLED=false
#WHATSAPP_PHONE_NUMBER_ID=
#WHATSAPP_ACCESS_TOKEN=
#WHATSAPP_TEMPLATE_NAME=new_workshop_registration
#WHATSAPP_TEMPLATE_LANGUAGE=en
#WHATSAPP_NOTIFY_TO=919011059088
#WHATSAPP_API_VERSION=v23.0

# --- Optional: participant email confirmation -----------------------------
#MAIL_ENABLED=false
#MAIL_HOST=smtp.example.com
#MAIL_PORT=587
#MAIL_USERNAME=
#MAIL_PASSWORD=
#MAIL_FROM=hello@kalagram.org
